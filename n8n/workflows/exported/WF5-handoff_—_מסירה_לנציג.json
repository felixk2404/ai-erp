{
  "name": "WF5-handoff — מסירה לנציג",
  "nodes": [
    {
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "name",
              "type": "string"
            },
            {
              "name": "phone",
              "type": "string"
            },
            {
              "name": "topic",
              "type": "string"
            },
            {
              "name": "sessionId",
              "type": "string"
            }
          ]
        }
      },
      "id": "00000000-0000-4000-8000-000000000000"
    },
    {
      "name": "Has Contact?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "n",
              "leftValue": "={{ String($json.name || '').trim().length >= 2 && !/לא נמסר|לא ידוע|unknown|null/i.test(String($json.name)) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "p",
              "leftValue": "={{ String($json.phone || '').replace(/\\D/g,'').length >= 9 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "notes": "המודל קרא לכלי בלי שם וטלפון (ראה בדיקת קבלה 2026-09-03). השער כאן, לא בפרומפט: בלי שני הפרטים אין ליד.",
      "id": "00000000-0000-4000-8000-000000000001"
    },
    {
      "name": "Missing Contact",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        600,
        -300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ok",
              "name": "ok",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "e",
              "name": "error",
              "value": "missing_contact",
              "type": "string"
            },
            {
              "id": "m",
              "name": "message",
              "value": "מה השם ומה הטלפון שנחזור אליו?",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "notes": "message הוא המשפט שהלקוח צריך לקבל, מילה במילה — המודל מצטט הודעות כלי, אז נותנים לו את הנוסח הנכון במקום הסבר פנימי.",
      "id": "00000000-0000-4000-8000-000000000002"
    },
