      ],
      "parameters": {
        "content": "## WF4 — סוכן מכירות (תשובות)\nGmail כל 30 דקות. תשובה מליד Contacted מסווגת: מעוניין → Qualified + משימת שיחה; לא מעוניין או \"הסר\" → Dead; תשובה אוטומטית → מתעלמים.\n\n**צריך:** Gmail ERP, Airtable ERP, OpenAI ERP",
        "height": 240,
        "width": 460,
        "color": 4
      },
      "id": "00000000-0000-4000-8000-000000000000"
    },
    {
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 30,
              "unit": "minutes"
            }
          ]
        },
        "simple": true,
        "filters": {
          "q": "in:inbox newer_than:2d"
        },
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "cZ21a0epfV1Bce6Y",
          "name": "Gmail ERP"
        }
      },
      "id": "00000000-0000-4000-8000-000000000001"
    },
    {
      "name": "Sender Email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e",
              "name": "email",
              "value": "={{ (((($json.From ?? $json.from?.text ?? $json.from?.value?.[0]?.address ?? '') + '').match(/[\\w.+-]+@[\\w.-]+\\.\\w+/)) || [''])[0].toLowerCase() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000002"
    },
    {
      "name": "Contacted Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/app1jXGnS2j0tCxEM/tblZQ6kwztOuvFSJ2",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "={{ \"AND(LOWER({Email})='\" + $json.email + \"', {Status}='Contacted')\" }}"
            },
            {
              "name": "maxRecords",
              "value": "1"
            }
          ]
        },
        "options": {}
