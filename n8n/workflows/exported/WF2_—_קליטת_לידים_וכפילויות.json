              "name": "filterByFormula",
              "value": "={{ (() => { const q = (s) => String(s).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\"); const e = ($json.fields.Email || '').trim().toLowerCase(); const p = ($json.fields.Phone || '').replace(/\\D/g, ''); if (e) return \"LOWER({Email})='\" + q(e) + \"'\"; if (p) return \"REGEX_REPLACE({Phone},\\\"[^0-9]\\\",\\\"\\\")='\" + q(p) + \"'\"; return 'FALSE()'; })() }}"
