{
  "name": "WF8 — הפקת PDF חשבונית",
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF_ERROR_ID__"
  },
  "nodes": [
    {
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "notes": "הרצה מלאה של חשבונית אחת נמדדה ב-64–312 שניות (הרצות 860/863/882/884/885/468). דקה אחת הייתה קצרה מהעבודה עצמה."
    },
    {
      "name": "Validated Invoices",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "search",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "__AIRTABLE_BASE_ID__"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "__TBL_INVOICES__"
        },
        "filterByFormula": "AND({Status}='validated', OR({PdfLockedAt} = BLANK(), DATETIME_DIFF(NOW(), {PdfLockedAt}, 'minutes') > 15))",
        "returnAll": false,
        "limit": 1,
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "__CRED_AIRTABLE__",
          "name": "Airtable ERP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "חשבונית שנתפסה על ידי הרצה אחרת לא נבחרת שוב, עד שהתפיסה פגה אחרי 15 דקות."
    },
    {
      "name": "Claim Invoice",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        390,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "תופס את החשבונית לפני העבודה, כך שהרצה מקבילה לא תבחר אותה ולא ייווצר PDF כפול. השדה נבחר במקום Status=generating כדי לא להכניס סטטוס חדש לממשק; התפיסה פגה לבד אחרי 15 דקות, כך שהרצה שנפלה לא תוקעת את החשבונית.",
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "update",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "__AIRTABLE_BASE_ID__"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "__TBL_INVOICES__"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.id }}",
            "PdfLockedAt": "={{ $now.toISO() }}"
          },
          "matchingColumns": [
            "id"
          ],
          "schema": [
            {
              "id": "id",
              "displayName": "id",
              "required": false,
              "defaultMatch": true,
              "display": true,
              "type": "string",
              "readOnly": true,
              "removed": false
            },
            {
              "id": "PdfLockedAt",
              "displayName": "PdfLockedAt",
              "required": false,
              "defaultMatch": false,
              "canBeUsedToMatch": true,
              "display": true,
              "type": "dateTime",
              "readOnly": false,
              "removed": false
            }
          ]
        },
        "options": {
          "typecast": true
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "__CRED_AIRTABLE__",
          "name": "Airtable ERP"
        }
      }
    },
    {
      "name": "Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/__AIRTABLE_BASE_ID__/__TBL_CUSTOMERS__",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "={{ \"{CustomerId}='\" + ($('Validated Invoices').first().json.fields.CustomerId || '') + \"'\" }}"
            },
            {
              "name": "maxRecords",
              "value": "1"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "__CRED_AIRTABLE__",
          "name": "Airtable ERP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "name": "Build HTML",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        780,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "i",
              "name": "invoiceId",
              "value": "={{ $('Validated Invoices').item.json.id }}",
              "type": "string"
            },
            {
              "id": "n",
              "name": "InvoiceNumber",
              "value": "={{ $('Validated Invoices').item.json.fields.InvoiceNumber }}",
              "type": "string"
            },
            {
              "id": "h",
              "name": "html",
              "type": "string",
              "value": "=<!doctype html><html lang=\"he\" dir=\"rtl\"><head><meta charset=\"utf-8\"><link href=\"https://fonts.googleapis.com/css2?family=Heebo:wght@400;700&display=swap\" rel=\"stylesheet\"><style>body{font-family:Heebo,Arial,sans-serif;color:#111;margin:0;padding:48px}h1{margin:0;font-size:28px;color:#0f766e}.muted{color:#666;font-size:13px}table{width:100%;border-collapse:collapse;margin-top:32px}th,td{text-align:right;padding:12px;border-bottom:1px solid #e5e7eb}th{background:#f0fdfa;font-weight:700}.sum td{color:#444}.total td{font-size:18px;font-weight:700;border-top:2px solid #0f766e}.box{display:flex;justify-content:space-between;margin-top:32px}.foot{margin-top:56px;font-size:12px;color:#666}</style></head><body><div class=\"box\"><div><h1>חשבונית מס</h1><div class=\"muted\">מספר {{ $('Validated Invoices').item.json.fields.InvoiceNumber }} · מסמך ממוחשב</div></div><div style=\"text-align:left\"><img src=\"https://ai-erp-rho.vercel.app/brand/logo-mark.png\" alt=\"\" style=\"height:56px;display:block;margin:0 0 6px auto\"><strong>איי.איי אלקטרוניקה בע\"מ</strong><div class=\"muted\">AI Electronics · ח.פ. 51-000000-0</div><div class=\"muted\">תאריך: {{ ($('Validated Invoices').item.json.fields.Created || $now.toISO()).split('T')[0].split('-').reverse().join('/') }}</div></div></div><div class=\"box\"><div><strong>לכבוד</strong><div>{{ String($json.records?.[0]?.fields?.Name || $('Validated Invoices').item.json.fields.CustomerId).replace(/[<>&]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;'})[c]) }}</div><div class=\"muted\">{{ String($json.records?.[0]?.fields?.Email || '').replace(/[<>&]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;'})[c]) }} {{ String($json.records?.[0]?.fields?.Phone || '').replace(/[<>&]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;'})[c]) }}</div><div class=\"muted\">מזהה לקוח: {{ String($('Validated Invoices').item.json.fields.CustomerId || '').replace(/[<>&]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;'})[c]) }}</div></div></div><table><thead><tr><th>פירוט</th><th>כמות</th><th>מחיר כולל מע״מ</th><th>סה\"כ</th></tr></thead><tbody>{{ (() => { try { const esc = s => String(s).replace(/[<>&]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;'})[c]); const f = n => Number(n).toLocaleString('he-IL', {minimumFractionDigits: 2}) + ' ₪'; return JSON.parse($('Validated Invoices').item.json.fields.Items || '[]').map(i => '<tr><td>' + esc(i.name) + ' <span class=\"muted\" dir=\"ltr\">' + esc(i.sku) + '</span></td><td>' + i.qty + '</td><td>' + f(i.price) + '</td><td>' + f(i.qty * i.price) + '</td></tr>').join(''); } catch (e) { return ''; } })() }}<tr class=\"total\"><td colspan=\"3\">סה״כ לתשלום</td><td>{{ Number($('Validated Invoices').item.json.fields.Total).toLocaleString('he-IL', {minimumFractionDigits: 2}) }} ₪</td></tr><tr class=\"sum\"><td colspan=\"3\">מתוכו מע״מ {{ Math.round($('Validated Invoices').item.json.fields.VatAmount / ($('Validated Invoices').item.json.fields.Amount || 1) * 100) }}%</td><td>{{ Number($('Validated Invoices').item.json.fields.VatAmount).toLocaleString('he-IL', {minimumFractionDigits: 2}) }} ₪</td></tr><tr class=\"sum\"><td colspan=\"3\">סה״כ לפני מע״מ</td><td>{{ Number($('Validated Invoices').item.json.fields.Amount).toLocaleString('he-IL', {minimumFractionDigits: 2}) }} ₪</td></tr></tbody></table><div class=\"foot\"><strong>זו הדגמה — לא בוצע חיוב.</strong> המסמך הופק אוטומטית על ידי מערכת AI-ERP. מחירי השורות כוללים מע״מ. תודה שקניתם באיי.איי אלקטרוניקה.</div></body></html>"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "HTML File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "operation": "toText",
        "sourceProperty": "html",
        "binaryPropertyName": "data",
        "options": {
          "fileName": "index.html"
        }
      }
    },
    {
      "name": "Gotenberg PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://gotenberg:3000/forms/chromium/convert/html",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "files",
              "inputDataFieldName": "data"
            },
            {
              "parameterType": "formData",
              "name": "waitDelay",
              "value": "1s"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          },
          "timeout": 120000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "name": "Upload to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1560,
        0
      ],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "={{ $('Build HTML').item.json.InvoiceNumber }}.pdf",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "__DRIVE_FOLDER_ID__"
        },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "__CRED_DRIVE__",
          "name": "Google Drive ERP"
        }
      }
    },
    {
      "name": "Mark Generated",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        1950,
        0
      ],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "update",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "__AIRTABLE_BASE_ID__"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "__TBL_INVOICES__"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $('Build HTML').item.json.invoiceId }}",
            "PdfUrl": "={{ $('Upload to Drive').item.json.webViewLink || ('https://drive.google.com/file/d/' + $('Upload to Drive').item.json.id + '/view') }}",
            "Status": "generated"
          },
          "matchingColumns": [
            "id"
          ],
          "schema": [
            {
              "id": "id",
              "displayName": "id",
              "required": false,
              "defaultMatch": true,
              "display": true,
              "type": "string",
              "readOnly": true,
              "removed": false
            },
            {
              "id": "PdfUrl",
              "displayName": "PdfUrl",
              "required": false,
              "defaultMatch": false,
              "canBeUsedToMatch": true,
              "display": true,
              "type": "string",
              "readOnly": false,
              "removed": false
            },
            {
              "id": "Status",
              "displayName": "Status",
              "required": false,
              "defaultMatch": false,
              "canBeUsedToMatch": true,
              "display": true,
              "type": "string",
              "readOnly": false,
              "removed": false
            }
          ]
        },
        "options": {
          "typecast": true
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "__CRED_AIRTABLE__",
          "name": "Airtable ERP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "name": "Share Public",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1690,
        0
      ],
      "parameters": {
        "resource": "file",
        "operation": "share",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "permissionsUi": {
          "permissionsValues": {
            "role": "reader",
            "type": "anyone",
            "allowFileDiscovery": false
          }
        },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "__CRED_DRIVE__",
          "name": "Google Drive ERP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
