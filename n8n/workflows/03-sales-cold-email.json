        "operation": "update",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "__AIRTABLE_BASE_ID__"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "__TBL_LEADS__"
        },
        "columns": {
