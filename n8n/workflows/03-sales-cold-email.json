{
  "name": "WF3 — סוכן מכירות (מיילים קרים)",
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF_ERROR_ID__"
  },
  "nodes": [
    {
      "name": "Every 3 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 3
            }
          ]
        }
      }
    },
    {
      "name": "Run Now Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        100
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "run-sales",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED_WEBHOOK__",
          "name": "ERP Webhook Secret"
        }
      }
    },
    {
      "name": "Next New Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "search",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "__AIRTABLE_BASE_ID__"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "__TBL_LEADS__"
        },
        "filterByFormula": "AND({Status}='New', {Email}!='')",
        "returnAll": false,
        "limit": 1,
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "__CRED_AIRTABLE__",
          "name": "Airtable ERP"
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "name": "Has Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        390,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "h1",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "name": "Sales Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=כתוב מייל קר ראשון לליד הבא.\nשם: {{ $('Next New Lead').first().json.fields.Name }}\nחברה: {{ $('Next New Lead').first().json.fields.Company || 'לא ידוע' }}\nמייל: {{ $('Next New Lead').first().json.fields.Email }}",
        "options": {
          "systemMessage": "__PROMPT_SALES__",
          "maxIterations": 3
        }
      }
    },
    {
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        520,
        220
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "__MODEL__"
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED_OPENAI__",
          "name": "OpenAI ERP"
        }
      }
    },
    {
      "name": "Send Email",
      "notes": "שולח לפני Mark Contacted בכוונה: כשל ב-Gmail משאיר את הליד New והוא ייבחר שוב בהרצה הבאה. הסדר ההפוך היה מאבד אותו לצמיתות. בלי retryOnFail במכוון — שליחת מייל אינה אידמפוטנטית, וניסיון חוזר אחרי כשל שקרה אחרי השליחה היה שולח מייל שני לאותו ליד.",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "sendTo": "={{ $('Next New Lead').first().json.fields.Email }}",
        "subject": "ציוד אלקטרוני לעסק — מקורי, עם אחריות יבואן | איי.איי אלקטרוניקה",
        "emailType": "text",
        "message": "={{ $('Sales Agent').first().json.output }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "__CRED_GMAIL__",
          "name": "Gmail ERP"
        }
      }
    },
    {
      "name": "Mark Contacted",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "update",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "__AIRTABLE_BASE_ID__"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "__TBL_LEADS__"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $('Next New Lead').first().json.id }}",
            "Status": "Contacted"
          },
          "matchingColumns": [
            "id"
          ],
          "schema": [
            {
              "id": "id",
              "displayName": "id",
              "required": false,
              "defaultMatch": true,
              "display": true,
              "type": "string",
              "readOnly": true,
              "removed": false
            },
            {
              "id": "Status",
              "displayName": "Status",
              "required": false,
              "defaultMatch": false,
              "canBeUsedToMatch": true,
              "display": true,
              "type": "string",
              "readOnly": false,
              "removed": false
            }
          ]
        },
        "options": {
          "typecast": true
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "__CRED_AIRTABLE__",
          "name": "Airtable ERP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "רץ אחרי השליחה. אם דווקא הוא נכשל, הליד נשאר New וייבחר שוב — כלומר מייל שני לאותו נמען. לכן retryOnFail כאן, ולא על השליחה עצמה."
    },
    {
      "name": "Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ok",
              "name": "ok",
              "value": "={{ true }}",
              "type": "boolean"
            },
            {
              "id": "s",
              "name": "sentTo",
              "value": "={{ $('Next New Lead').first().json.fields.Email }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "No Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        650,
        200
      ],
      "notes": "בלי זה, ריצה בלי לידים חדשים מחזירה ל-webhook את שגיאת n8n על היעדר פריט במקום תשובה אמיתית.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ok",
              "name": "ok",
              "value": "={{ true }}",
              "type": "boolean"
            },
            {
              "id": "s",
              "name": "sent",
              "value": "={{ 0 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Every 3 Hours": {
      "main": [
        [
          {
            "node": "Next New Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Now Webhook": {
      "main": [
        [
          {
            "node": "Next New Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Next New Lead": {
      "main": [
        [
          {
            "node": "Has Lead?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sales Agent": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Mark Contacted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Contacted": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Sales Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Has Lead?": {
      "main": [
        [
          {
            "node": "Sales Agent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
