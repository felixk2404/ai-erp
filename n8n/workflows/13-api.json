        "method": "PATCH",
        "url": "=https://api.airtable.com/v0/__AIRTABLE_BASE_ID__/{{ encodeURIComponent($json.body.table) }}/{{ encodeURIComponent($json.body.id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fields: $json.body.payload, typecast: true }) }}",
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "__CRED_AIRTABLE__",
          "name": "Airtable ERP"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
