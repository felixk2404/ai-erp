      ],
      "notes": "ענף השגיאה של כל צומת שיכול ליפול. בלעדיו הדפדפן פשוט תלוי עד ה-timeout שלו.",
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'השירות לא זמין כרגע. נסו שוב בעוד רגע.' }) }}",
        "options": {
          "responseCode": 502
        }
      }
    }
