    {
      "name": "Find Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        880
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/__AIRTABLE_BASE_ID__/__TBL_ORDERS__",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "=AND({OrderNumber}='{{ String($json.body.orderNumber || '').toUpperCase().replace(/[^A-Z0-9-]/g, '') }}', LOWER({Email})='{{ String($json.body.email || '').toLowerCase().replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\") }}')"
            },
            {
              "name": "maxRecords",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "__CRED_AIRTABLE__",
          "name": "Airtable ERP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "name": "Find Invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        880
      ],
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/__AIRTABLE_BASE_ID__/__TBL_INVOICES__",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "=AND({InvoiceNumber}!='', {InvoiceNumber}='{{ ($json.records?.[0]?.fields?.InvoiceNumber || '').replace(/'/g, '') }}')"
            },
            {
              "name": "maxRecords",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "__CRED_AIRTABLE__",
          "name": "Airtable ERP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "name": "Respond Status",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1040,
        880
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ (() => { const fo = $('Find Order').first().json; if (fo.error || !fo.records) return JSON.stringify({ ok: false, error: 'השירות לא זמין כרגע. נסו שוב בעוד רגע.' }); const o = fo.records[0]; if (!o) return JSON.stringify({ ok: false, error: 'ההזמנה לא נמצאה' }); const f = o.fields; const inv = $json.records?.[0]?.fields || {}; let items = []; try { items = JSON.parse(f.Items || '[]'); } catch (e) {} return JSON.stringify({ ok: true, order: { orderNumber: f.OrderNumber, status: f.Status, items, subtotal: f.Subtotal, shipping: f.Shipping, total: f.Total, created: f.Created, invoiceNumber: f.InvoiceNumber || null, pdfUrl: inv.PdfUrl || null, invoiceStatus: inv.Status || null } }); })() }}",
        "options": {
          "responseCode": "={{ ({ down: 502, missing: 404, ok: 200 })[(() => { const fo = $('Find Order').first().json; if (fo.error || !fo.records) return 'down'; return fo.records[0] ? 'ok' : 'missing'; })()] }}"
        }
      }
    },
    {
      "name": "Respond Bad Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
