{
  "name": "WF5 — סוכן שירות לקוחות",
  "settings": { "executionOrder": "v1", "errorWorkflow": "__WF_ERROR_ID__" },
  "nodes": [
    { "name": "Telegram Trigger", "type": "n8n-nodes-base.telegramTrigger", "typeVersion": 1.2, "position": [0, 0],
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "credentials": { "telegramApi": { "id": "__CRED_TELEGRAM_CUSTOMER__", "name": "Telegram Customer" } } },
    { "name": "Support Agent", "type": "@n8n/n8n-nodes-langchain.agent", "typeVersion": 3.1, "position": [300, 0],
      "parameters": { "promptType": "define", "text": "={{ $json.message.text }}", "options": { "systemMessage": "__PROMPT_CUSTOMER_SERVICE__", "maxIterations": 6 } } },
    { "name": "OpenAI Chat Model", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "typeVersion": 1.3, "position": [160, 220],
      "parameters": { "model": { "__rl": true, "mode": "list", "value": "__MODEL__" }, "options": {} },
      "credentials": { "openAiApi": { "id": "__CRED_OPENAI__", "name": "OpenAI ERP" } } },
    { "name": "Memory", "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow", "typeVersion": 1.3, "position": [340, 220],
      "parameters": { "sessionIdType": "customKey", "sessionKey": "=support-{{ $('Telegram Trigger').item.json.message.chat.id }}", "contextWindowLength": 8 } },
    { "name": "knowledge_base", "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase", "typeVersion": 1.3, "position": [520, 220],
      "parameters": { "mode": "retrieve-as-tool", "toolName": "knowledge_base", "toolDescription": "מדיניות העסק (משלוחים, החזרות, אחריות, תשלומים, שעות פעילות, שאלות נפוצות) וקטלוג המוצרים עם מחירים ומלאי. חפש כאן לפני כל תשובה עובדתית.", "tableName": { "__rl": true, "mode": "list", "value": "documents" }, "topK": 6, "includeDocumentMetadata": true, "options": { "queryName": "match_documents" } },
      "credentials": { "supabaseApi": { "id": "__CRED_SUPABASE__", "name": "Supabase ERP" } } },
    { "name": "Embeddings", "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi", "typeVersion": 1.2, "position": [520, 420],
      "parameters": { "model": "text-embedding-3-small", "options": {} },
      "credentials": { "openAiApi": { "id": "__CRED_OPENAI__", "name": "OpenAI ERP" } } },
    { "name": "Send Reply", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [700, 0],
      "parameters": { "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}", "text": "={{ ($json.output || 'מצטערים, לא הצלחנו לענות כרגע.').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}", "additionalFields": { "appendAttribution": false, "parse_mode": "HTML" } },
      "credentials": { "telegramApi": { "id": "__CRED_TELEGRAM_CUSTOMER__", "name": "Telegram Customer" } } }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "Support Agent", "type": "main", "index": 0 }]] },
    "Support Agent": { "main": [[{ "node": "Send Reply", "type": "main", "index": 0 }]] },
    "OpenAI Chat Model": { "ai_languageModel": [[{ "node": "Support Agent", "type": "ai_languageModel", "index": 0 }]] },
    "Memory": { "ai_memory": [[{ "node": "Support Agent", "type": "ai_memory", "index": 0 }]] },
    "knowledge_base": { "ai_tool": [[{ "node": "Support Agent", "type": "ai_tool", "index": 0 }]] },
    "Embeddings": { "ai_embedding": [[{ "node": "knowledge_base", "type": "ai_embedding", "index": 0 }]] }
  }
}
