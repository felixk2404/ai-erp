{
  "name": "WF5-core — סוכן שירות לקוחות",
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF_ERROR_ID__"
  },
  "nodes": [
    {
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "message",
              "type": "string"
            },
            {
              "name": "sessionId",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Support Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        300,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message }}",
        "options": {
          "systemMessage": "__PROMPT_CUSTOMER_SERVICE__",
          "maxIterations": 6
        }
      }
    },
    {
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        160,
        220
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "__MODEL__"
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED_OPENAI__",
          "name": "OpenAI ERP"
        }
      }
    },
    {
      "name": "Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        340,
        220
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "=support-{{ $('When Executed by Another Workflow').first().json.sessionId }}",
        "contextWindowLength": 8
      }
    },
    {
      "name": "knowledge_base",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.3,
      "position": [
        520,
        220
      ],
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "knowledge_base",
        "toolDescription": "מדיניות העסק בלבד: משלוחים, החזרות והחלפות, אחריות, תשלומים, חשבוניות, שעות פעילות, שאלות נפוצות. לא מוצרים.",
        "tableName": {
          "__rl": true,
          "mode": "list",
          "value": "documents"
        },
        "topK": 5,
        "includeDocumentMetadata": true,
        "options": {
          "queryName": "match_documents",
          "metadata": {
            "metadataValues": [
              {
                "name": "type",
                "value": "policy"
              }
            ]
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "__CRED_SUPABASE__",
          "name": "Supabase ERP"
        }
      }
    },
    {
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        520,
        420
      ],
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED_OPENAI__",
          "name": "OpenAI ERP"
        }
      }
    },
    {
      "name": "Reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        700,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r",
              "name": "reply",
              "value": "={{ $json.output }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "products_catalog",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.3,
      "position": [
        700,
        220
      ],
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "products_catalog",
        "toolDescription": "קטלוג המוצרים של החנות: שם, מק\"ט, קטגוריה, מחיר בשקלים, זמינות במלאי ותיאור. חובה להשתמש בו לכל שאלה על מוצר, דגם, מחיר או מלאי. חפש לפי סוג המוצר (למשל \"אוזניות\", \"מטען\", \"מסך\").",
        "tableName": {
          "__rl": true,
          "mode": "list",
          "value": "documents"
        },
        "topK": 8,
        "includeDocumentMetadata": true,
        "options": {
          "queryName": "match_documents",
          "metadata": {
            "metadataValues": [
              {
                "name": "type",
                "value": "product"
              }
            ]
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "__CRED_SUPABASE__",
          "name": "Supabase ERP"
        }
      }
    },
    {
      "name": "Embeddings 2",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        700,
        420
      ],
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED_OPENAI__",
          "name": "OpenAI ERP"
        }
      }
    },
    {
      "name": "check_stock",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        520,
        480
      ],
      "parameters": {
        "toolDescription": "בדיקת מלאי ומחיר חיים מהמערכת. קלט: מק\"ט (למשל TY-HP-200) או מילה מהשם (למשל אוזניות). מחזיר שם, מק\"ט, מחיר בשקלים כולל מע\"מ, כמות במלאי (Stock) וקטגוריה. שירותים (קטגוריה 'שירותים') תמיד זמינים.",
        "method": "GET",
        "url": "https://api.airtable.com/v0/__AIRTABLE_BASE_ID__/__TBL_PRODUCTS__?fields[]=Name&fields[]=Sku&fields[]=Price&fields[]=Stock&fields[]=Category&fields[]=InStock&maxRecords=5",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "=OR(FIND(LOWER('{{ $fromAI('query', 'מק\"ט או מילה מהשם של המוצר', 'string').replace(/'/g, '') }}'), LOWER({Sku})), FIND(LOWER('{{ $fromAI('query', 'מק\"ט או מילה מהשם של המוצר', 'string').replace(/'/g, '') }}'), LOWER({Name})))"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "__CRED_AIRTABLE__",
          "name": "Airtable ERP"
        }
      }
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Support Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Support Agent": {
      "main": [
        [
          {
            "node": "Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Support Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Memory": {
      "ai_memory": [
        [
          {
            "node": "Support Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "knowledge_base": {
      "ai_tool": [
        [
          {
            "node": "Support Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings": {
      "ai_embedding": [
        [
          {
            "node": "knowledge_base",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "products_catalog": {
      "ai_tool": [
        [
          {
            "node": "Support Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings 2": {
      "ai_embedding": [
        [
          {
            "node": "products_catalog",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "check_stock": {
      "ai_tool": [
        [
          {
            "node": "Support Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  }
}
