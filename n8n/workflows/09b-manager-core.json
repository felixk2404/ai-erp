    },
    {
      "name": "Build Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        3380,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "m",
              "name": "message",
              "value": "={{ $('When Executed by Another Workflow').first().json.message }}",
              "type": "string"
            },
            {
              "id": "s",
              "name": "sessionId",
              "value": "={{ $('When Executed by Another Workflow').first().json.sessionId }}",
              "type": "string"
            },
            {
              "id": "d",
              "name": "data",
              "value": "={{ JSON.stringify({ invoices_by_status: $('Aggregate Invoices').first().json.invoices, leads_by_status: $('Aggregate Leads').first().json.leads, tasks_by_status: $('Aggregate Tasks').first().json.tasks, orders_by_status: $('Aggregate Orders').first().json.orders, orders_today: $('Search Orders').all().filter(i => DateTime.fromISO(i.json.fields?.Created || '').setZone('Asia/Jerusalem').toFormat('yyyy-MM-dd') === $now.setZone('Asia/Jerusalem').toFormat('yyyy-MM-dd')).length, orders_today_total: $('Search Orders').all().filter(i => DateTime.fromISO(i.json.fields?.Created || '').setZone('Asia/Jerusalem').toFormat('yyyy-MM-dd') === $now.setZone('Asia/Jerusalem').toFormat('yyyy-MM-dd')).reduce((s,i) => s + (i.json.fields?.Total || 0), 0), recent_orders: [...$('Search Orders').all()].sort((a, b) => String(a.json.fields?.Created || '').localeCompare(String(b.json.fields?.Created || ''))).slice(-5).map(i => ({ n: i.json.fields?.OrderNumber, name: i.json.fields?.Name, total: i.json.fields?.Total, status: i.json.fields?.Status })), open_tasks: [...$('Search Tasks').all()].filter(i => i.json.fields?.Status !== 'done').sort((a, b) => String(b.json.fields?.Created || '').localeCompare(String(a.json.fields?.Created || ''))).slice(0, 8).map(i => ({ title: i.json.fields?.Title, source: i.json.fields?.Source || 'manual', ref: i.json.fields?.RefId || null })), generated_at: $now.toISO() }) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Manager Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        3640,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=שאלת הבעלים: {{ $json.message }}\n\nנתונים מסוכמים מהמערכת (JSON):\n{{ $json.data }}",
        "options": {
          "systemMessage": "__PROMPT_MANAGER__",
          "maxIterations": 5
        }
      }
    },
    {
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        3540,
        220
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "__MODEL__"
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED_OPENAI__",
          "name": "OpenAI ERP"
        }
      }
    },
    {
      "name": "Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        3740,
        220
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "=manager-{{ $('Build Context').item.json.sessionId }}",
        "contextWindowLength": 6
      }
    },
    {
      "name": "Reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        3980,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r",
              "name": "reply",
              "value": "={{ $json.output }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
