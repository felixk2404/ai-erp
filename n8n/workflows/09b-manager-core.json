{
  "name": "WF9-core — סוכן המנהל",
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF_ERROR_ID__"
  },
  "nodes": [
    {
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "message",
              "type": "string"
            },
            {
              "name": "sessionId",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Search Invoices",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        260,
        0
      ],
      "alwaysOutputData": true,
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "search",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "__AIRTABLE_BASE_ID__"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "__TBL_INVOICES__"
        },
        "filterByFormula": "",
        "returnAll": true,
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "__CRED_AIRTABLE__",
          "name": "Airtable ERP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "name": "Summarize Invoices",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "fieldsToSummarize": {
          "values": [
            {
              "aggregation": "sum",
              "field": "fields.Total"
            },
            {
              "aggregation": "count",
              "field": "fields.InvoiceNumber"
            }
          ]
        },
        "fieldsToSplitBy": "fields.Status",
        "options": {}
      },
      "notes": "בלי continueIfFieldNotFound: שינוי שם עמודה ב-Airtable ייפול ברעש, ולא יגיע לסוכן כ-0 ₪ הכנסות."
    },
    {
      "name": "Aggregate Invoices",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        780,
        0
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "invoices",
        "options": {}
      }
    },
    {
