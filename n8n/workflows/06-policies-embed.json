{
  "name": "WF6 — מדיניות → מאגר וקטורי",
  "settings": { "executionOrder": "v1", "errorWorkflow": "__WF_ERROR_ID__" },
  "nodes": [
    { "name": "Reindex Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "position": [0, 0],
      "parameters": { "httpMethod": "POST", "path": "reindex-policies", "authentication": "headerAuth", "responseMode": "lastNode", "options": {} },
      "credentials": { "httpHeaderAuth": { "id": "__CRED_WEBHOOK__", "name": "ERP Webhook Secret" } } },
    { "name": "Delete Old Policies", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [260, 0],
      "parameters": { "method": "DELETE", "url": "__SUPABASE_URL__/rest/v1/documents", "authentication": "predefinedCredentialType", "nodeCredentialType": "supabaseApi",
        "sendQuery": true, "queryParameters": { "parameters": [ { "name": "metadata->>type", "value": "eq.policy" } ] }, "options": {} },
      "credentials": { "supabaseApi": { "id": "__CRED_SUPABASE__", "name": "Supabase ERP" } } },
    { "name": "Read Policy Files", "type": "n8n-nodes-base.readWriteFile", "typeVersion": 1, "position": [520, 0],
      "parameters": { "fileSelector": "/data/course/policies/*.md", "options": {} } },
    { "name": "Supabase Insert", "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase", "typeVersion": 1.3, "position": [780, 0],
      "parameters": { "mode": "insert", "tableName": { "__rl": true, "mode": "list", "value": "documents" }, "embeddingBatchSize": 100, "options": { "queryName": "match_documents" } },
      "credentials": { "supabaseApi": { "id": "__CRED_SUPABASE__", "name": "Supabase ERP" } } },
    { "name": "Embeddings", "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi", "typeVersion": 1.2, "position": [700, 220],
      "parameters": { "model": "text-embedding-3-small", "options": {} },
      "credentials": { "openAiApi": { "id": "__CRED_OPENAI__", "name": "OpenAI ERP" } } },
    { "name": "Load Files", "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader", "typeVersion": 1.1, "position": [900, 220],
      "parameters": { "dataType": "binary", "binaryMode": "allInputData", "loader": "textLoader", "textSplittingMode": "custom",
        "options": { "metadata": { "metadataValues": [ { "name": "type", "value": "policy" }, { "name": "source", "value": "={{ $binary.data.fileName }}" } ] } } } },
    { "name": "Split Text", "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter", "typeVersion": 1, "position": [900, 420],
      "parameters": { "chunkSize": 800, "chunkOverlap": 100, "options": {} } },
    { "name": "Done", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [1040, 0], "executeOnce": true,
      "parameters": { "assignments": { "assignments": [ { "id": "ok", "name": "ok", "value": "={{ true }}", "type": "boolean" }, { "id": "c", "name": "chunks", "value": "={{ $input.all().length }}", "type": "number" } ] }, "options": {} } }
  ],
  "connections": {
    "Reindex Webhook": { "main": [[{ "node": "Delete Old Policies", "type": "main", "index": 0 }]] },
    "Delete Old Policies": { "main": [[{ "node": "Read Policy Files", "type": "main", "index": 0 }]] },
    "Read Policy Files": { "main": [[{ "node": "Supabase Insert", "type": "main", "index": 0 }]] },
    "Supabase Insert": { "main": [[{ "node": "Done", "type": "main", "index": 0 }]] },
    "Embeddings": { "ai_embedding": [[{ "node": "Supabase Insert", "type": "ai_embedding", "index": 0 }]] },
    "Load Files": { "ai_document": [[{ "node": "Supabase Insert", "type": "ai_document", "index": 0 }]] },
    "Split Text": { "ai_textSplitter": [[{ "node": "Load Files", "type": "ai_textSplitter", "index": 0 }]] }
  }
}
